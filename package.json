{
  "name": "sitescope",
  "version": "4.4.0",
  "private": true,
  "description": "Instant website intelligence: preview, metadata, category classification, security analysis, and an isolated sandbox. No signup required.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run csp:check && npm run dom:check && npm test",
    "csp:sync": "node scripts/sync-csp.mjs",
    "csp:check": "node scripts/sync-csp.mjs --check",
    "dom:sync": "node scripts/generate-dom-map.mjs",
    "dom:check": "node scripts/generate-dom-map.mjs --check",
    "icons": "node scripts/generate-icons.mjs",
    "podman:build": "podman build -t sitescope:latest -f Containerfile .",
    "podman:run": "podman run -d --name sitescope -p 8080:8080 localhost/sitescope:latest",
    "podman:stop": "podman stop sitescope",
    "podman:rm": "podman rm -f sitescope"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberlog69/sitescope.git"
  },
  "keywords": [
    "website",
    "security",
    "scanner",
    "pwa",
    "diagnostics",
    "seo",
    "sandbox"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bugs": {
    "url": "https://github.com/cyberlog69/sitescope/issues"
  },
  "homepage": "https://github.com/cyberlog69/sitescope#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
